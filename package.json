{
  "name": "traffic-advanced",
  "version": "0.0.0",
  "private": true,
  "description": "Road closure, traffic and HGV diversion information for England",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "capture:open": "node scripts/capture/capture-open.ts",
    "capture:nh": "node scripts/capture/capture-nh-api.ts",
    "capture:day": "npm run capture:open && npm run capture:nh",
    "matcher:run": "node scripts/analysis/run-matcher.ts",
    "heldout:build": "node scripts/p0/heldout-build.ts",
    "heldout:evaluate": "node scripts/p0/heldout-evaluate.ts",
    "api:publish": "node scripts/publish/publish-snapshot.ts",
    "api:upload": "node scripts/publish/upload-snapshot-r2.ts",
    "ingest:once": "node scripts/ingest/ingest-once.ts",
    "worker:dev": "npm run build && wrangler dev",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "maplibre-gl": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
